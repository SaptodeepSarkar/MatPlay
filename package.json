{
  "name": "matplay",
  "version": "0.1.0",
  "description": "Local-first TypeScript terminal music player with a cover-art-adaptive TUI.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "matplay": "./dist/main.js"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-ffi tsx src/main.tsx",
    "start": "NODE_OPTIONS=--experimental-ffi tsx src/main.tsx",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-ffi vitest run",
    "test:watch": "NODE_OPTIONS=--experimental-ffi vitest",
    "check": "NODE_OPTIONS=--experimental-ffi tsx src/check.ts"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "chokidar": "^4.0.3",
    "music-metadata": "^11.7.2",
    "react": "^19.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^19.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=26.4"
  }
}
