#!/bin/sh
# Global entry point for MatPlay. OpenTUI's native core requires the
# experimental FFI flag on Node.js, which npm bin shims cannot pass —
# so this wrapper sets it before handing off to the built output.
SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  RESOLVED="$(readlink -f "$SELF" 2>/dev/null)" && SELF="$RESOLVED"
fi
if case "${NODE_OPTIONS:-}" in *experimental-ffi*) false;; *) true;; esac; then
  export NODE_OPTIONS="--experimental-ffi ${NODE_OPTIONS:-}"
fi
exec node "$(dirname "$SELF")/../dist/main.js" "$@"
